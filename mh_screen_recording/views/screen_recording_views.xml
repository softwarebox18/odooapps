<odoo>
    <record id="view_screen_recording_tree" model="ir.ui.view">
        <field name="name">screen.recording.tree</field>
        <field name="model">screen.recording</field>
        <field name="arch" type="xml">
            <list>
                <field name="status"/>
                <field name="user_id"/>
                <field name="duration"/>
                <field name="recorded_at"/>
            </list>
        </field>
    </record>

    <record id="view_screen_recording_form" model="ir.ui.view">
        <field name="name">screen.recording.form</field>
        <field name="model">screen.recording</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="status"/>
                        <field name="user_id"/>
                        <field name="failed_attempts"/>
                        <field name="video_url" invisible="1"/>
                        <field name="duration"/>
                        <field name="recorded_at"/>
                    </group>
                    <!-- Video preview section -->
                    <group>
                        <field name="video_url" widget="video_preview_widget" string=""/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open Screen Recordings -->
    <record id="action_screen_recording" model="ir.actions.act_window">
        <field name="name">Screen Recordings</field>
        <field name="res_model">screen.recording</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_screen_recording_tree"/>
    </record>

    <!-- Parent menu item for Screen Recordings (under Timesheets) -->
    <menuitem id="menu_screen_recording_root" name="Screen Recordings" parent="hr_timesheet.timesheet_menu_root" groups="base.group_erp_manager"/>

    <!-- Screen Recording menu item that links to the action -->
    <menuitem id="menu_screen_recording" name="Recordings" parent="menu_screen_recording_root" action="action_screen_recording" groups="base.group_erp_manager"/>

    <record id="res_config_settings_view_form_screen_recording" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.screen.recording</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Screen Recording" string="Screen Recording" name="mh_screen_recording" groups="base.group_erp_manager">
                    <!-- Block for Screen Recording Settings -->
                    <block title="Screen Recording Settings" name="screen_recording_setting_container">
                        <!-- Setting: Enable/Disable Recording -->
                        <setting id="enable_recording_setting" help="Enable or disable screen recording functionality.">
                            <field name="enable_recording"/>
                        </setting>

                        <!-- Setting: Recording Check Interval -->
                        <setting id="recording_check_interval_setting" help="Set the interval (in minutes) for checking attendance status and scheduling screen recording.">
                            <label string="Recording Check Interval (in Minutes)" for="recording_check_interval"/>
                            <field name="recording_check_interval" widget="integer" nolabel="1"/>
                            <div class="text-muted">
                                Set the interval (in minutes) for checking attendance status and scheduling screen recording.
                            </div>
                        </setting>

                        <!-- Setting: Minimum Recording Delay -->
                        <setting id="recording_min_delay_setting" help="Set the minimum delay time (in minutes) before starting a recording.">
                            <label string="Minimum Recording Delay (in Minutes)" for="recording_min_delay"/>
                            <field name="recording_min_delay" widget="integer" nolabel="1"/>
                            <div class="text-muted">
                                Set the minimum delay time (in minutes) before starting a recording.
                            </div>
                        </setting>

                        <!-- Setting: Maximum Recording Delay -->
                        <setting id="recording_max_delay_setting" help="Set the maximum delay time (in minutes) before starting a recording.">
                            <label string="Maximum Recording Delay (in Minutes)" for="recording_max_delay"/>
                            <field name="recording_max_delay" widget="integer" nolabel="1"/>
                            <div class="text-muted">
                                Set the maximum delay time (in minutes) before starting a recording.
                            </div>
                        </setting>

                        <!-- Setting: Recording Duration -->
                        <setting id="recording_duration_setting" help="Set the duration of video recordings in seconds.">
                            <label string="Recording Duration (In Seconds)" for="recording_duration"/>
                            <field name="recording_duration" widget="integer" nolabel="1"/>
                            <div class="text-muted">
                                Set the duration of video recordings in seconds.
                            </div>
                        </setting>

                        <!-- Setting: Screen Sharing Timeout -->
                        <setting id="screen_sharing_timeout_setting" help="Set screen sharing timeout in seconds.">
                            <label string="Screen Sharing Timeout (In Seconds)" for="screen_sharing_timeout"/>
                            <field name="screen_sharing_timeout" widget="integer" nolabel="1"/>
                            <div class="text-muted">
                                Set screen sharing timeout in seconds.
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
