<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.select.company</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='inter_company']" position="after">
                <div id="inter_company" title="If checked, all companies will be selected by default. If unchecked, only the default company will be selected.">
                    <div class="o_setting_left_pane">
                        <field name="is_allowed_companies"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label string="Select/Unselect All Companies By Default" for="is_allowed_companies"/>
                        <div class="text-muted">
                            If checked, all companies will be selected by default. If unchecked, only the default company will be selected.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
