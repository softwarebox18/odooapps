<odoo>
    <data>
        <!-- Inherit Sale Order Form View -->
        <record id="view_order_form_inherit_can_edit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.can.edit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                    <attribute name="readonly">is_readonly == False</attribute>
                </xpath>
            </field>
        </record>

        <!-- Inherit Product Form View -->
        <record id="product_template_only_form_view_inherit_can_edit" model="ir.ui.view">
            <field name="name">product.form.inherit.can.edit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='list_price']" position="attributes">
                    <attribute name="readonly">is_readonly == False</attribute>
                </xpath>
            </field>
        </record>

        <!-- Inherit Invoice Lines Form View -->
        <record id="view_move_form_inherit_can_edit" model="ir.ui.view">
            <field name="name">account.move.form.inherit.can.edit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
                    <attribute name="readonly">is_readonly == False</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>