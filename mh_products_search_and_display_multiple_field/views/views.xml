<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.display.product</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='restrict_template_rendering_setting']" position="after">
                <div class="col-12 col-lg-6" style="padding-left: 0; padding-right: 0;">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="product_search_fields"/>
                            <div class="text-muted">
                                Select the fields to be used for product search.
                            </div>
                            <field name="product_search_fields" widget="many2many_tags"/>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6" style="padding-left: 0; padding-right: 0;">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="product_display_fields"/>
                            <div class="text-muted">
                                Select the fields to display in product dropdown or many2one field.
                            </div>
                            <field name="product_display_fields" widget="many2many_tags"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
