<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_product" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.display.product</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="message_translation_setting" position="after">
                <setting id="product_search_fields_setting" title="Select fields for product search." help="Select fields to be used for product search in sales, purchase etc.">
                    <field name="product_search_fields" widget="many2many_tags"/>
                </setting>
                <setting id="product_display_fields_setting" title="Select fields to display in product dropdown." help="Select fields to display in product dropdown (many2one) field.">
                    <field name="product_display_fields" widget="many2many_tags"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>